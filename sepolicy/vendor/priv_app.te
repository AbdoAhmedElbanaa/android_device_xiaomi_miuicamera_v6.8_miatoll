# Permissions for privileged camera applications (MiuiCamera / ExtraPhoto)
allow priv_app proc_stat:file open;
allow priv_app vendor_file:file { execute map open getattr read };
allow priv_app vendor_default_prop:file { getattr map open };
allow priv_app app_data_file:file execute;

allow priv_app default_android_hwservice:hwservice_manager find;
allow priv_app vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow priv_app vendor_hal_misys_hwservice:hwservice_manager find;
allow priv_app default_android_service:service_manager find;

# Android 16/17 (SDK 36) compatibility domain if present
# (avoids priv_app_36 denial on Android 16)
